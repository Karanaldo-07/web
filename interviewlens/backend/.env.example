# Never commit real secrets.
# Configure these in Vercel Environment Variables.
TAVILY_API_KEY=your_tavily_key_here

# Persistent community database (Supabase).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_server_only_secret_key
INTERVIEWLENS_CONFIRM_SALT=generate_a_long_random_secret

# Legacy fallback supported temporarily:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_server_only_key
